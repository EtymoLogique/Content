{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.etymologique.invalid/vocabulaire.schema.json",
  "title": "Vocabulaire contrôlé",
  "description": "Types de relation ou de transformation (ADR 0003, modèle de données § 3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["types"],
  "properties": {
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "libelles"],
        "properties": {
          "code": { "$ref": "communs.schema.json#/$defs/code_vocabulaire" },
          "orientee": { "type": "boolean" },
          "acyclique": { "type": "boolean" },
          "libelles": {
            "$ref": "communs.schema.json#/$defs/libelles",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nom"],
              "properties": {
                "nom": { "$ref": "communs.schema.json#/$defs/texte" },
                "description": { "$ref": "communs.schema.json#/$defs/texte" }
              }
            }
          }
        }
      }
    }
  }
}
